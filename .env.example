APP_NAME="Empleos Aqua"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=empleosaqua_empleosa_bolsa_empleo
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

INTERSTICIAL=false
INTERSTICIAL_MOBILE=false


# SMTP (correos de contacto y recuperación de clave)
SMTP_HOST=mail.editec.cl
SMTP_PORT=25
SMTP_USERNAME=empleosaqua@empleosaqua.cl
SMTP_PASSWORD=
SMTP_ENCRYPTION=
